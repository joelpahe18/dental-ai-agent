# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Credenciales de Meta Cloud API (WhatsApp Business)
WHATSAPP_TOKEN=tu_whatsapp_access_token_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=token_seguro_para_webhook_de_meta

# Modelo de Lenguaje (OpenAI, Gemini o Anthropic)
OPENAI_API_KEY=tu_openai_api_key_aqui
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Integración de Calendario (Google Calendar)
GOOGLE_SERVICE_ACCOUNT_EMAIL=dental-agent@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=tu_calendar_id@group.calendar.google.com

# Información de la Clínica (Personalizable por Tenant / Marca Blanca)
CLINIC_NAME="Clínica Dental Digital Medellín"
CLINIC_ADDRESS="El Poblado, Cra 43A # 1-50, Torre Médica, Consultorio 602, Medellín"
CLINIC_PHONE="+57 300 000 0000"
